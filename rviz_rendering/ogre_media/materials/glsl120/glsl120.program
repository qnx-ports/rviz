//all shaders, sorted by name


fragment_program rviz/glsl120/depth_circle.frag glsl glsles
{
  source depth_circle.frag
  default_params
  {
    param_named_auto alpha custom 1
    param_named_auto far_clip_distance far_clip_distance
  }
}


fragment_program rviz/glsl120/depth.frag glsl glsles
{
  source depth.frag
  default_params
  {
    param_named_auto alpha custom         1
    param_named_auto far_clip_distance far_clip_distance
  }
}


vertex_program rviz/glsl120/depth.vert glsl glsles
{
  source depth.vert
  preprocessor_defines WITH_DEPTH=1
  default_params {
    param_named_auto worldviewproj_matrix worldviewproj_matrix
    param_named_auto worldview_matrix     worldview_matrix
  }
}


fragment_program rviz/glsl120/flat_color.frag glsl glsles
{
  source flat_color.frag
  default_params
  {
    param_named_auto highlight custom 5
    param_named_auto alpha custom 1
  }
}


fragment_program rviz/glsl120/flat_color_circle.frag glsl glsles
{
  source flat_color_circle.frag
  default_params
  {
    param_named_auto highlight custom 5
    param_named_auto alpha custom 1
  }
}


fragment_program rviz/glsl120/indexed_8bit_image.frag glsl glsles
{
  source indexed_8bit_image.frag
  default_params
  {
    param_named_auto alpha custom 1
  }
}


vertex_program rviz/glsl120/indexed_8bit_image.vert glsl glsles
{
  source indexed_8bit_image.vert
  default_params {
    param_named_auto worldviewproj_matrix worldviewproj_matrix
  }
}


fragment_program rviz/glsl120/pass_color_circle.frag glsl glsles
{
  source pass_color_circle.frag
}


fragment_program rviz/glsl120/pass_color.frag glsl glsles
{
  source pass_color.frag
}


fragment_program rviz/glsl120/pickcolor_circle.frag glsl glsles
{
  source pickcolor_circle.frag
  default_params
  {
    param_named_auto pick_color custom    2
  }
}


fragment_program rviz/glsl120/pickcolor.frag glsl glsles
{
  source pickcolor.frag
  default_params
  {
    param_named_auto pick_color custom    2
  }
}


fragment_program rviz/glsl120/black.frag glsl glsles
{
  source black.frag
}


vertex_program rviz/glsl120/point.vert glsl glsles
{
  source point.vert
  default_params {
    param_named_auto worldviewproj_matrix worldviewproj_matrix
    param_named_auto size custom          0
  }
}


vertex_program rviz/glsl120/point.vert(with_depth) glsl glsles
{
  source point.vert
  preprocessor_defines WITH_DEPTH=1
  default_params {
    param_named_auto worldviewproj_matrix worldviewproj_matrix
    param_named_auto worldview_matrix worldview_matrix
    param_named_auto size custom          0
  }
}


fragment_program rviz/glsl120/shaded_circle.frag glsl glsles
{
  source shaded_circle.frag
  default_params
  {
    param_named_auto highlight custom 5
    param_named_auto alpha custom 1
  }
}


fragment_program rviz/glsl120/smooth_square.frag glsl glsles
{
  source smooth_square.frag
  default_params
  {
    param_named_auto highlight custom 5
    param_named_auto alpha custom 1
  }
}


vertex_program rviz/glsl120/basic.vert glsl glsles
{
  source depth.vert
  default_params {
    param_named_auto worldviewproj_matrix worldviewproj_matrix
  }
}
